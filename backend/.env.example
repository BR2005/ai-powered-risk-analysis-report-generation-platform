# Database Configuration (defaults to local SQLite if omitted)
DATABASE_URL=sqlite:///./platform.db

# Required shared key for assessment, finding, and report API routes.
# Generate a unique value and never commit production credentials.
API_ACCESS_KEY=replace_with_a_long_random_secret

# Primary AI Model Provider: Configured for Google's Gemma 4
LLM_PROVIDER=gemma-4
GEMMA_MODEL=gemma-4-12b-it
# Supported Gemma 4 model sizes:
# - gemma-4-e2b (Edge/Mobile)
# - gemma-4-e4b (Lightweight on-device)
# - gemma-4-12b-it (Unified multimodal instruction-tuned, recommended)
# - gemma-4-26b-a4b (MoE developer workstation)
# - gemma-4-31b-it (Enterprise high-performance)

# Option A: Google AI Studio API Key for Gemma 4
GEMMA_API_KEY=your_google_ai_studio_api_key_here
# GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Option B: Local Ollama hosting Gemma 4
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma-4

# Option C: OpenAI-compatible server (vLLM / LM Studio / OpenRouter) hosting Gemma 4
OPENAI_API_KEY=your_endpoint_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gemma-4-12b-it
